# Azure Synapse Configuration
SYNAPSE_WORKSPACE_NAME=your-synapse-workspace
CLOUD_SUFFIX=usgovcloudapi.net

# Subscription and Resource Group
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=your-resource-group

# Dedicated SQL Pool
DEDICATED_SQL_POOL=your-dedicated-pool

# Lake Database
LAKE_DATABASE=your-lake-database

# Serverless SQL database
SERVERLESS_DATABASE=master

# Azure Data Lake Storage
ADLS_ACCOUNT=your-adls-account
ADLS_FILESYSTEM=your-filesystem
ADLS_CONTAINER=your-container
